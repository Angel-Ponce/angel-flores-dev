---
import DarkTheme from '@components/dark-theme.astro';
import Skills from '@components/skills.astro';
import Tippy from '@components/tippy.astro';
import { getSkills } from '@tools/skills';
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import '../index.css';
import { navItems } from '@tools/nav-items';
import { contactMethods } from '@tools/contact-methods';
import MadeInGt from '@components/made-in-gt.astro';

export type DefaultPageContent = {
  title: string;
  description: string;
};

export interface Props {
  withFooter?: boolean;
  withHeader?: boolean;
  page?: DefaultPageContent;
}

const { withFooter, withHeader, page } = Astro.props;
---

<html lang="en" x-data :class="$store.theme.value">
  <head>
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-heading" preload />
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="I'm a software engineer from Guatemala, checkout my profile!"
    />

    <title>Angel Flores</title>
  </head>
  <body
    class="font-text text-dark-base dark:text-white-base bg-white-base dark:bg-dark-base scrollbar-thumb-dark-base/30 dark:scrollbar-thumb-white-base/30 scrollbar-track-transparent"
  >
    <main class="flex min-h-screen w-full items-stretch justify-center">
      <section
        class:list={[
          'flex w-full max-w-[8.27in] flex-col gap-12 p-12',
          withFooter && 'pb-0',
        ]}
      >
        {
          withHeader && (
            <header
              x-data="{ isExpanded: false, toggle(){ this.isExpanded = !this.isExpanded } }"
              class="*:border-dark-base/15 *:dark:border-white-base/15 *:bg-white-base/80 *:dark:bg-dark-base/80 z-40 font-semibold will-change-transform *:rounded-xl *:border *:backdrop-blur-sm"
              x-bind:class="isExpanded ? 'fixed top-0 left-0 w-full h-screen' : 'sticky flex items-center justify-end gap-2 top-4 sm:justify-center'"
            >
              <nav class="hidden h-12 w-fit items-center justify-center gap-4 sm:flex sm:px-4.5 sm:py-2.5">
                {navItems.map((item) => (
                  <a
                    class="hover:text-primary flex items-center gap-0.5 rounded-md px-1 py-px transition-colors duration-200"
                    href={item.path}
                  >
                    <Icon name={item.iconName} size={20} />
                    {item.label}
                  </a>
                ))}
              </nav>

              {['dark', 'light'].map((theme) => (
                <div
                  x-show={`$store.theme.value === '${theme}'`}
                  class="h-12 w-12 cursor-pointer items-center justify-center"
                  x-on:click="$store.theme.toggle()"
                  x-bind:class="isExpanded ? 'hidden': 'flex'"
                >
                  <Icon
                    name={`solar:${theme === 'dark' ? 'sun-2-bold-duotone' : 'moon-bold-duotone'}`}
                    size={20}
                  />
                </div>
              ))}

              <div
                x-on:click="!isExpanded && toggle()"
                x-bind:class="isExpanded ? 'flex flex-col gap-8 p-4 w-full h-full' : 'flex h-12 w-12 cursor-pointer items-center justify-center sm:hidden'"
              >
                <div x-bind:class="isExpanded && 'hidden'">
                  <Icon name="solar:hamburger-menu-linear" size={28} />
                </div>
                <div
                  class="flex cursor-pointer justify-end"
                  x-bind:class="!isExpanded && 'hidden'"
                  x-on:click="() => { $event.stopPropagation(); toggle(); }"
                >
                  <Icon name="solar:close-circle-bold-duotone" size={28} />
                </div>

                {navItems.map((item) => (
                  <a
                    class="flex items-center justify-center text-3xl"
                    href={item.path}
                    x-bind:class="!isExpanded && 'hidden'"
                  >
                    {item.label}
                  </a>
                ))}
              </div>
            </header>
          )
        }

        <div class="flex flex-1 flex-col gap-[inherit]">
          {
            page && (
              <div>
                <h1 class="font-heading text-4xl font-semibold">
                  {page.title}
                </h1>

                <p class="opacity-50">{page.description}</p>
              </div>
            )
          }

          <slot />
        </div>

        {
          withFooter && (
            <footer class="border-dark-base/50 dark:border-white-base/50 flex flex-wrap items-start justify-between gap-14 bg-[radial-gradient(var(--pattern-fg)_1px,transparent_0)] bg-size-[10px_10px] bg-fixed px-8 py-10 text-sm [--pattern-fg:var(--color-dark-base)]/10 dark:[--pattern-fg:var(--color-white-base)]/10">
              <div class="flex flex-col gap-3">
                <div>
                  <h2 class="font-heading text-2xl font-semibold">
                    Angel Flores
                  </h2>
                  <p class="opacity-50">Designed & developed by me ♥️</p>

                  <MadeInGt />
                </div>

                <div class="flex flex-col gap-2">
                  <span class="opacity-50">This site was built with:</span>

                  <Skills
                    skills={getSkills(
                      'TypeScript',
                      'TailwindCSS',
                      'Astro',
                      'AlpineJS',
                    )}
                    title=""
                  />
                </div>
              </div>

              <div class="flex items-start gap-8">
                <div class="flex flex-col gap-3">
                  <div>
                    <h2 class="font-heading text-2xl font-semibold">Pages</h2>
                    <p class="opacity-50">Explore my site</p>
                  </div>

                  <ul>
                    {navItems.map((item) => (
                      <li class="py-0.5">
                        <a href={item.path}>{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex flex-col gap-3">
                  <div>
                    <h2 class="font-heading text-2xl font-semibold">Contact</h2>
                    <p class="opacity-50">Let's work together</p>
                  </div>

                  <ul>
                    {contactMethods
                      .filter((method) => method.name !== 'Location')
                      .map((item) => (
                        <li class="py-0.5">
                          <a href={item.href} target="_blank" rel="noreferrer">
                            {item.name}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              </div>
            </footer>
          )
        }
      </section>
    </main>

    <DarkTheme />
    <Tippy />
  </body>
</html>
