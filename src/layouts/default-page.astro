---
import DarkTheme from '@components/dark-theme.astro';
import Skills from '@components/skills.astro';
import Tippy from '@components/tippy.astro';
import { getSkills } from '@tools/skills';
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import '../index.css';
import { navItems } from '@tools/nav-items';
import { contactMethods } from '@tools/contact-methods';

export interface Props {
  withFooter?: boolean;
}

const { withFooter } = Astro.props;
---

<html lang="en" x-data :class="$store.theme.value">
  <head>
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-heading" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="I'm a software engineer from Guatemala, checkout my profile!"
    />

    <title>Angel Flores</title>
  </head>
  <body
    class="font-text text-dark-base dark:text-white-base bg-white-base dark:bg-dark-base scrollbar-thumb-dark-base/30 dark:scrollbar-thumb-white-base/30 scrollbar-track-transparent"
  >
    <main class="flex w-full justify-center">
      <section
        class:list={[
          'relative w-full max-w-[8.27in] p-12',
          withFooter && 'pb-0',
        ]}
      >
        <slot />

        {
          withFooter && (
            <footer class="border-dark-base/50 dark:border-white-base/50 flex flex-wrap items-start justify-between gap-14 bg-[radial-gradient(var(--pattern-fg)_1px,transparent_0)] bg-size-[10px_10px] bg-fixed px-8 py-10 text-sm [--pattern-fg:var(--color-dark-base)]/15 dark:[--pattern-fg:var(--color-white-base)]/15">
              <div class="flex flex-col gap-3">
                <div>
                  <h2 class="font-heading text-2xl font-semibold">
                    Angel Flores
                  </h2>
                  <p class="opacity-50">Designed & developed by me ♥️</p>
                  <div class="flex items-center gap-1">
                    <Icon name="flag:gt-4x3" class="rounded-md" size={18} />
                    from Guatemala
                  </div>
                </div>

                <div class="flex flex-col gap-2">
                  <span class="opacity-50">This site was built with:</span>

                  <Skills
                    skills={getSkills(
                      'TypeScript',
                      'TailwindCSS',
                      'Astro',
                      'AlpineJS',
                    )}
                    title=""
                  />
                </div>
              </div>

              <div class="flex items-start gap-8">
                <div class="flex flex-col gap-3">
                  <div>
                    <h2 class="font-heading text-2xl font-semibold">Pages</h2>
                    <p class="opacity-50">Explore my site</p>
                  </div>

                  <ul>
                    {navItems.map((item) => (
                      <li class="py-0.5">
                        <a href={item.path} target="_blank" rel="noreferrer">
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex flex-col gap-3">
                  <div>
                    <h2 class="font-heading text-2xl font-semibold">Contact</h2>
                    <p class="opacity-50">Let's work together</p>
                  </div>

                  <ul>
                    {contactMethods
                      .filter((method) => method.name !== 'Location')
                      .map((item) => (
                        <li class="py-0.5">
                          <a href={item.href} target="_blank" rel="noreferrer">
                            {item.name}
                          </a>
                        </li>
                      ))}
                  </ul>
                </div>
              </div>
            </footer>
          )
        }
      </section>
    </main>

    <DarkTheme />
    <Tippy />
  </body>
</html>
