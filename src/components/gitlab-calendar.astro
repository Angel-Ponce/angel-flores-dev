---
import { calendar } from '@tools/calendar';
import {
  addDays,
  addMonths,
  endOfMonth,
  endOfWeek,
  format,
  formatISO,
  startOfDay,
  startOfMonth,
  startOfWeek,
  subYears,
} from 'date-fns';
import { v4 as uuidV4 } from 'uuid';

const now = new Date();
const calendarId = `calendar-${uuidV4()}`;

const minMonth = subYears(now, 1);

const months = Array.from(
  new Set(
    Object.keys(calendar)
      .map((isoDate) => new Date(isoDate))
      .sort((dateA, dateB) => dateA.getTime() - dateB.getTime())
      .map((date) => format(date, 'MMM. yy')),
  ),
);

const getMonthWeeks = (date: Date) => {
  const days: Date[] = [];
  let startDay = startOfWeek(startOfMonth(date));
  const endDay = endOfWeek(endOfMonth(date));

  while (startDay <= endDay) {
    days.push(startDay);
    startDay = addDays(startDay, 1);
  }

  const weeks: Date[][] = [];

  for (let i = 0; i < days.length / 7; i++) {
    weeks.push(days.slice(i * 7, (i + 1) * 7));
  }

  return weeks;
};

const dateIsInRange = (date: Date) =>
  startOfDay(date) >= startOfDay(minMonth) &&
  startOfDay(date) <= startOfDay(now);
---

<section
  class="flex scrollbar-thin items-start gap-px overflow-x-auto"
  id={calendarId}
>
  {
    months.map((month, index) => (
      <div class="flex flex-col gap-px">
        <span class="text-xs opacity-50">{month}</span>

        <div class="flex items-start gap-px">
          {getMonthWeeks(addMonths(minMonth, index)).map(
            (week) =>
              !!week.length && (
                <div class="flex flex-col gap-px">
                  {week.map((day) => {
                    const isInRange = dateIsInRange(day);
                    const contributions =
                      calendar[formatISO(day, { representation: 'date' })] ?? 0;

                    return (
                      <div
                        data-count={
                          calendar[formatISO(day, { representation: 'date' })]
                        }
                        data-date={formatISO(day)}
                        class:list={[
                          'h-4 w-4 cursor-pointer rounded-xs',
                          isInRange && contributions > 0
                            ? 'bg-primary dark:bg-secondary'
                            : 'bg-dark-base dark:bg-white-base',
                        ]}
                        style={{
                          opacity:
                            isInRange && contributions > 0
                              ? contributions / 30
                              : 0.05,
                        }}
                      />
                    );
                  })}
                </div>
              ),
          )}
        </div>
      </div>
    ))
  }
</section>

<script define:vars={{ calendarId }}>
  const calendarElement = document.getElementById(calendarId);
  calendarElement?.scrollTo({
    left: calendarElement.scrollWidth,
    behavior: 'instant',
  });
</script>
