---
import {
  addDays,
  addMonths,
  endOfMonth,
  endOfWeek,
  format,
  formatISO,
  startOfDay,
  startOfMonth,
} from 'date-fns';
import { v4 as uuidV4 } from 'uuid';

interface Props {
  calendar: Record<string, number>;
  lastYear: Date;
  now: Date;
}

const calendarId = `calendar-${uuidV4()}`;

const { calendar, lastYear, now } = Astro.props;

const getMonthDays = (date: Date) => {
  const days: Date[] = [];
  let startDay = startOfDay(startOfMonth(date));
  const endDay = endOfWeek(endOfMonth(date));

  while (startDay <= endDay) {
    days.push(startDay);
    startDay = addDays(startDay, 1);
  }

  return days;
};

const dateIsShown = (date: Date, month: Date) => {
  const isFromMonth = date.getMonth() === month.getMonth();
  const isFromLastYear = date >= lastYear && date <= now;

  return isFromLastYear && isFromMonth;
};

const getOpacity = (count: number) => {
  const maxCount = Math.min(count, 30);
  const maxEvents = 30;
  const opacity = (maxCount / maxEvents) * 0.9;

  return opacity + 0.1;
};
---

<section
  class="flex scrollbar-thin items-start gap-2 overflow-x-auto"
  id={calendarId}
>
  {
    Array.from({ length: 12 }, (_, index) => (
      <div class="flex shrink-0 flex-col gap-2">
        <span class="text-xs opacity-50">
          {format(addMonths(lastYear, index), 'MMM. yy')}
        </span>

        <div class="grid grid-cols-7 gap-px">
          {getMonthDays(addMonths(lastYear, index)).map((day) => (
            <div
              data-count={calendar[formatISO(day, { representation: 'date' })]}
              data-date={formatISO(day)}
              class="bg-primary dark:bg-secondary h-4 w-4 cursor-pointer rounded-sm transition-transform duration-200 hover:scale-90"
              style={{
                opacity: dateIsShown(day, addMonths(lastYear, index))
                  ? getOpacity(
                      calendar[formatISO(day, { representation: 'date' })] ?? 0,
                    )
                  : 0,
              }}
            />
          ))}
        </div>
      </div>
    ))
  }
</section>

<script define:vars={{ calendarId }}>
  const calendarElement = document.getElementById(calendarId);
  calendarElement?.scrollTo({
    left: calendarElement.scrollWidth,
    behavior: 'instant',
  });
</script>
