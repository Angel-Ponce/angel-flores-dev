---
import ResumeSection from '@components/resume-section.astro';
import Skills from '@components/skills.astro';
import resumeAngelImage from '@images/resume-angel.webp';
import DefaultPage from '@layouts/default-page.astro';
import Topo from '@svg/topo.svg';
import { contactMethods } from '@tools/contact-methods';
import { resumeSections, mainSkills } from '@tools/resume-sections';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
---

<DefaultPage>
  <section class="relative">
    <Topo
      class="pointer-events-none absolute top-0 left-0 -translate-y-12 mask-b-from-20% mask-b-to-80% opacity-5"
    />
    <div class="float-right mb-3 ml-3 h-40 w-40 overflow-hidden rounded-lg">
      <Image
        src={resumeAngelImage}
        width={320}
        height={320}
        alt="Angel Flores"
        decoding="async"
        loading="lazy"
      />
    </div>

    <h1 class="font-heading text-4xl font-semibold">Angel Flores</h1>
    <h2 class="text-primary text-2xl">Software Engineer</h2>
    <Skills title="My stack" skills={mainSkills} />

    <section class="flex flex-wrap items-center gap-3 py-3">
      {
        contactMethods.map(({ label, href, iconName }) => (
          <div class="flex items-center gap-1">
            {<Icon name={iconName} size={16} class="text-secondary" />}
            <a
              class="bg-secondary/20 rounded-md px-1 py-px text-sm"
              target="_blank"
              rel="noreferrer"
              href={href}
            >
              {label}
            </a>
          </div>
        ))
      }
    </section>

    <section class="py-3">
      Hi, thank you for being here, I'm a software engineer from Guatemala with <b
        class="text-primary">+6 years of experience</b
      > who enjoys working smart, hard and funny.
      <i>Let's do it together!</i>
    </section>

    {resumeSections.map((section) => <ResumeSection {...section} />)}
  </section>
</DefaultPage>

<style>
  @media print {
    @page {
      margin: 0;
    }
  }
</style>
