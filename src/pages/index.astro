---
import ContributionsCalendar from '@components/contributions-calendar.astro';
import Skills from '@components/skills.astro';
import angelBikerImage from '@images/angel-biker.webp';
import angelImage from '@images/angel.webp';
import bikeImage from '@images/bike.webp';
import familyImage from '@images/family.webp';
import ositaImage from '@images/osita.webp';
import wifeImage from '@images/wife.webp';
import DefaultPage from '@layouts/default-page.astro';
import { contactMethods } from '@tools/contact-methods';
import { experience, mainSkills } from '@tools/resume-sections';
import { hobbies } from '@tools/hobbies';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ResumeDateRange from '@components/resume-date-range.astro';
---

<DefaultPage withFooter withHeader>
  <div class="flex flex-wrap items-start gap-12">
    <div class="relative w-full max-w-75 shrink-0">
      <Image
        src={angelBikerImage}
        alt="Angel Biker"
        layout="full-width"
        class="rounded-xl"
      />

      <div
        class="border-primary/30 dark:border-secondary/30 absolute -top-3 -left-3 h-14 w-14 rounded-tl-3xl border-t-4 border-l-4"
      >
      </div>
      <div
        class="border-primary/30 dark:border-secondary/30 absolute -bottom-3 -left-3 h-14 w-14 rounded-bl-3xl border-b-4 border-l-4"
      >
      </div>

      <div
        class="border-primary/30 dark:border-secondary/30 absolute -top-3 -right-3 h-14 w-14 rounded-tr-3xl border-t-4 border-r-4"
      >
      </div>
      <div
        class="border-primary/30 dark:border-secondary/30 absolute -right-3 -bottom-3 h-14 w-14 rounded-br-3xl border-r-4 border-b-4"
      >
      </div>

      <div
        class="shadow-dark-base absolute right-2 bottom-2 h-16 w-16 rounded-full shadow-2xl"
      >
        <Image
          src={angelImage}
          alt="Angel"
          width={120}
          height={120}
          class="rounded-full"
        />
      </div>
    </div>
    <div class="flex min-w-50 flex-1 flex-col justify-between gap-3">
      <div>
        <h1 class="font-heading text-4xl font-semibold">Angel Flores</h1>
        <h2 class="text-primary text-xl">Software Engineer</h2>
        <Skills skills={mainSkills} />
      </div>

      <div>
        <b>Welcome!</b> this is my personal space ✨ here you will find all about
        me, my background, experience, hobbies, relevant blog posts, feels and so
        on..

        <div class="flex items-center gap-2 py-2">
          {
            contactMethods.map((method) => (
              <a
                data-tippy
                href={method.href}
                class="bg-primary/10 text-primary/90 rounded-md p-1"
                target="_blank"
                rel="noreferrer"
              >
                <Icon name={method.iconName} size={16} />

                <span data-tippy-content>{method.name}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <section class="flex flex-col gap-3">
    <div>
      <h3 class="dark:text-primary font-heading text-2xl font-semibold">
        My Fingerprint
      </h3>
      <p class="opacity-50">Make every day your masterpiece</p>
    </div>

    <ContributionsCalendar />
  </section>

  <section class="flex flex-col gap-3">
    <div>
      <h3 class="dark:text-primary font-heading text-2xl font-semibold">
        Current Target
      </h3>
      <p class="opacity-50">What do I do?</p>
    </div>

    <p>
      I'm currently working as a <b>Frontend Engineer</b> building <b
        >web & apps</b
      > that feels unique, robust, and fast. I'm passionate of modern technologies,
      but I also have experience with largest and legacy projects.
    </p>
  </section>

  <section class="flex flex-col gap-3">
    <div>
      <h3 class="dark:text-primary font-heading text-2xl font-semibold">
        Experience
      </h3>
      <p class="opacity-50">the world through code</p>
    </div>

    <div class="flex flex-col gap-0.5">
      <div class="grid gap-3 sm:grid-cols-2">
        {
          experience.companies.map((company) => (
            <div class="bg-dark-base/5 dark:bg-secondary/5 flex min-h-24 flex-col gap-3 rounded-xl p-4 transition-transform duration-200 hover:-translate-y-1 hover:skew-1">
              <div>
                <div class="font-heading text-xl font-semibold">
                  {company.title}
                </div>
                <div class="text-sm">{company.subtitle}</div>
                <ResumeDateRange range={company.dateRange} />
              </div>
            </div>
          ))
        }
      </div>

      <div class="text-sm">
        <span>Need more detail?</span>
        <a
          class="text-primary dark:text-secondary font-semibold"
          href="/resume"
          target="_blank"
          rel="noreferrer">Checkout my resume</a
        >
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-3">
    <div>
      <h3 class="dark:text-primary font-heading text-2xl font-semibold">
        About me
      </h3>
      <p class="opacity-50">A picture is worth a thousand words</p>
    </div>

    <div
      class="grid grid-cols-2 items-center justify-center gap-4 text-center text-xs sm:grid-cols-4"
    >
      <div
        class="rotate-2 transition-transform duration-200 hover:scale-105 hover:rotate-0"
      >
        <Image
          layout="full-width"
          class="rounded-xl"
          src={wifeImage}
          alt="family"
        />
      </div>
      <div
        class="-rotate-2 overflow-hidden transition-transform duration-200 hover:scale-105 hover:rotate-0"
      >
        <Image
          layout="full-width"
          class="rounded-xl"
          src={ositaImage}
          alt="family"
        />
      </div>
      <div
        class="rotate-2 overflow-hidden transition-transform duration-200 hover:scale-105 hover:rotate-0"
      >
        <Image
          layout="full-width"
          class="rounded-xl"
          src={familyImage}
          alt="family"
        />
      </div>
      <div
        class="-rotate-2 overflow-hidden transition-transform duration-200 hover:scale-105 hover:rotate-0"
      >
        <Image
          layout="full-width"
          class="rounded-xl"
          src={bikeImage}
          alt="family"
        />
      </div>
    </div>

    <div class="flex flex-col gap-5 py-5">
      <h4 class="font-heading text-xl font-semibold">My hobbies</h4>

      {
        hobbies.map((hobby) => (
          <div class="flex items-start gap-3">
            <div class="relative shrink-0">
              {hobby.image && (
                <div class="h-10 w-10">
                  <Image
                    src={hobby.image}
                    width={hobby.image.width}
                    height={hobby.image.height}
                    alt={hobby.title}
                    class="rounded-xl"
                  />
                </div>
              )}

              {!hobby.image && (
                <Icon name={hobby.iconName} size={40} class="rounded-xl" />
              )}
            </div>

            <div>
              <h5 class="font-heading font-semibold">{hobby.title}</h5>
              <span set:html={hobby.description} />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="flex flex-col items-center gap-3 rounded-xl text-center">
    <div>
      <h2
        class="font-heading from-primary/10 via-primary to-primary/10 bg-linear-to-r bg-clip-text text-[3rem] font-semibold text-transparent sm:text-[5rem]"
      >
        Let's Connect
      </h2>
      <p class="opacity-50">I'm ready to your next project</p>

      <div class="flex flex-wrap items-center justify-center gap-12 px-6 pt-12">
        {
          contactMethods
            .filter((method) => method.name !== 'Location')
            .map((method) => (
              <a
                class="flex flex-col items-center"
                href={method.href}
                target="_blank"
                rel="noreferrer"
              >
                <div class="flex items-start gap-2">
                  <Icon name={method.iconName} size={24} class="opacity-50" />

                  <div class="text-left whitespace-nowrap">
                    <h3 class="font-heading text-xl font-semibold">
                      {method.name}
                    </h3>
                  </div>
                </div>

                <span class="text-sm opacity-50">{method.label}</span>
              </a>
            ))
        }
      </div>
    </div>
  </section>
</DefaultPage>
