---
import ContributionsCalendar from '@components/contributions-calendar.astro';
import CvDateRange from '@components/cv-date-range.astro';
import Skills from '@components/skills.astro';
import ToggleThemeButton from '@components/toggle-theme-button.astro';
import angelBikerImage from '@images/angel-biker.webp';
import angelImage from '@images/angel.webp';
import DefaultPage from '@layouts/default-page.astro';
import { experience, mainSkills } from '@tools/cv-sections';
import { Image } from 'astro:assets';

const now = new Date();
---

<DefaultPage>
  <div class="flex flex-col gap-12">
    <header
      class="bg-white-base/50 dark:bg-dark-base/50 shadow-dark-base/10 dark:shadow-white-base/10 sticky top-4 z-40 flex items-center justify-between rounded-xl px-4 py-3 font-semibold shadow-sm backdrop-blur-2xl"
    >
      <div></div>

      <ToggleThemeButton />
    </header>

    <div class="flex flex-wrap gap-12">
      <div class="relative h-56.25 w-75 shrink-0">
        <Image
          src={angelBikerImage}
          alt="Angel Biker"
          width={600}
          height={450}
          class="rounded-xl"
        />

        <div
          class="border-primary/30 dark:border-secondary/30 shadow-primary absolute -top-3 -left-3 h-14 w-14 rounded-tl-3xl border-t-4 border-l-4"
        >
        </div>
        <div
          class="border-primary/30 dark:border-secondary/30 absolute -bottom-3 -left-3 h-14 w-14 rounded-bl-3xl border-b-4 border-l-4"
        >
        </div>

        <div
          class="border-primary/30 dark:border-secondary/30 shadow-primary absolute -top-3 -right-3 h-14 w-14 rounded-tr-3xl border-t-4 border-r-4"
        >
        </div>
        <div
          class="border-primary/30 dark:border-secondary/30 absolute -right-3 -bottom-3 h-14 w-14 rounded-br-3xl border-r-4 border-b-4"
        >
        </div>

        <div
          class="shadow-dark-base absolute right-2 bottom-2 h-16 w-16 rounded-full shadow-2xl"
        >
          <Image
            src={angelImage}
            alt="Angel"
            width={120}
            height={120}
            class="rounded-full"
          />
        </div>
      </div>
      <div class="flex min-w-[320px] flex-1 flex-col justify-between gap-3">
        <div>
          <h1 class="font-heading text-4xl font-semibold">Angel Flores</h1>
          <h2 class="text-primary text-xl">Software Engineer</h2>
          <Skills skills={mainSkills} />
        </div>

        <div>
          <b>Welcome!</b> this is my personal space ✨ here you will find all about
          me, my background, experience, hobbies, relevant blog posts, feels and so
          on..
        </div>
      </div>
    </div>

    <section class="flex flex-col gap-3">
      <div>
        <h3 class="dark:text-primary font-heading text-2xl font-semibold">
          My Fingerprint
        </h3>
        <p class="opacity-50">Make every day your masterpiece</p>
      </div>

      <ContributionsCalendar />
    </section>

    <section class="flex flex-col gap-3">
      <div>
        <h3 class="dark:text-primary font-heading text-2xl font-semibold">
          Current Target
        </h3>
        <p class="opacity-50">What do I do?</p>
      </div>

      <p>
        I'm currently working on <b>Frontend Development</b> building <b
          >web & apps</b
        > that feels unique, robust, and fast. I'm passionate of modern technologies,
        but I also have experience with largest and legacy projects.
      </p>
    </section>

    <section class="flex flex-col gap-3">
      <div>
        <h3 class="dark:text-primary font-heading text-2xl font-semibold">
          Experience
        </h3>
        <p class="opacity-50">the world through code</p>
      </div>

      <div class="flex flex-col gap-px">
        <div class="grid gap-3 sm:grid-cols-2">
          {
            experience.companies.map((company) => (
              <div class="bg-secondary/15 flex min-h-24 flex-col gap-3 rounded-xl p-4 transition-transform duration-200 hover:-translate-y-1 hover:skew-1">
                <div>
                  <div class="font-heading text-xl font-semibold">
                    {company.title}
                  </div>
                  <div class="text-sm">{company.subtitle}</div>
                  <CvDateRange range={company.dateRange} />
                </div>
              </div>
            ))
          }
        </div>

        <div class="text-sm">
          <span>Need more detail?</span>
          <a class="text-primary dark:text-secondary font-semibold" href="/cv"
            >Checkout my cv</a
          >
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <div>
        <h3 class="dark:text-primary font-heading text-2xl font-semibold">
          Who I am?
        </h3>
        <p class="opacity-50">Just a good boy...</p>
      </div>
    </section>
  </div>
</DefaultPage>
